# Plantilla segura de entorno: este archivo no contiene credenciales válidas.
# Copia a .env local o usa un gestor de secretos; nunca pongas claves reales en Git.

# Server
PORT=8081
NODE_ENV=development

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=50

# Internal Service Authentication
INTERNAL_AUTH_TOKEN=xxxxx--xxxxx

# Backend Services
AUTH_SERVICE_URL=http://localhost:7000
NOTIFICATIONS_SERVICE_URL=http://localhost:7004
WALLET_LEDGER_SERVICE_URL=http://localhost:9001
PAYMENTS_SERVICE_URL=http://localhost:9000
INTERNAL_TRANSFERS_SERVICE_URL=http://localhost:3006
SIGNATURE_KEYS_SERVICE_URL=http://localhost:3007

# JWT Configuration (must match microservices)
JWT_SECRET=xxxxx--xxxxx
JWT_EXPIRATION=1h

# API Configuration
API_PREFIX=api/v1
API_TIMEOUT=30000

# Micro fondear
FUNDING_SERVICE_URL=http://localhost:3000

# Micro enviar
SEND_SERVICE_URL=http://localhost:3000

# Micro remesas
REMITTANCES_SERVICE_URL=http://localhost:3010

# Micro de ahorros
SAVINGS_SERVICE_URL=http://localhost:3011

# Micro de prestamos
LOANS_SERVICE_URL=http://localhost:3012

#Micro Deco31416pay
Deco31416PAY_SERVICE_URL=http://localhost:3013

# Micro pricing aggregator
PRICING_AGGREGATOR_SERVICE_URL=http://localhost:3013

# Additional variables referenced in this project; replace markers only in local configuration.
DECOPAY_SERVICE_URL=xxxxx--xxxxx
MOVEMENTS_SERVICE_URL=xxxxx--xxxxx
P2P_CORE_URL=xxxxx--xxxxx
REDEEM_SERVICE_URL=xxxxx--xxxxx
