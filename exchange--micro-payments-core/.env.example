INTERNAL_AUTH_TOKEN=xxxxx--xxxxx

# Microservices URLs
WALLET_LEDGER_CORE_URL=http://localhost:3003/api/v1

# Downstream services (internal)
MICRO_CUSTODY_FIAT_BASE_URL=http://localhost:3001
MICRO_CUSTODY_CRYPTO_BASE_URL=http://localhost:3003
