# Plantilla segura de entorno: este archivo no contiene credenciales válidas.
# Copia a .env local o usa un gestor de secretos; nunca pongas claves reales en Git.

# Micro Pricing Fee Launchpad — Precios de tokens con peg a crypto base
# Copia este archivo a .env.local y ajusta los valores

# Server
PORT=3016
NODE_ENV=development
APP_NAME=DECO EXCHANGE

# Database
MONGODB_URI=mongodb://localhost:27017/deco-exchange-micro
REDIS_URI=redis://localhost:6379

# Security
INTERNAL_AUTH_TOKEN=xxxxx--xxxxx

# Service URLs
ASSET_REGISTRY_URL=http://localhost:3010/api/v1
PRICING_CRYPTO_URL=http://localhost:3012/api/v1
PRICING_CRYPTO_AUTH_TOKEN=xxxxx--xxxxx

# Peg Sync
PEG_SYNC_INTERVAL_MS=300000

# Additional variables referenced in this project; replace markers only in local configuration.
COINGECKO_DAILY_LIMIT=xxxxx--xxxxx
COINMARKETCAP_DAILY_LIMIT=xxxxx--xxxxx
CONTACT_EMAIL=contact@example.invalid
CONTACT_URL=https://example.invalid
CORS_ORIGIN=http://localhost:3000
CRON_MAX_INTERVAL_MS=xxxxx--xxxxx
CRON_MIN_INTERVAL_MS=xxxxx--xxxxx
CRYPTOCOMPARE_DAILY_LIMIT=xxxxx--xxxxx
LICENSE_NAME=Deco31416
LICENSE_URL=https://deco31416.com
SWAGGER_DESCRIPTION=xxxxx--xxxxx
