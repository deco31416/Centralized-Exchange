# Plantilla segura de entorno: este archivo no contiene credenciales válidas.
# Copia a .env local o usa un gestor de secretos; nunca pongas claves reales en Git.

# Server
PORT=3014
NODE_ENV=development

# App Identity
APP_NAME=DECO EXCHANGE
SWAGGER_DESCRIPTION=Microservicio de precios fiat con agregación multi-source, motor de entropía, bandas de precio (admin/auto), deltas por corredor, y sistema de alertas tipo semáforo.
CONTACT_URL=https://exchange.example.invalid
CONTACT_EMAIL=xxxxx--xxxxx@example.invalid
LICENSE_NAME=MIT
LICENSE_URL=https://opensource.org/licenses/MIT

# Database
MONGODB_URI=mongodb://localhost:27017/deco-exchange-fiat
REDIS_URI=redis://localhost:6379

# Security
INTERNAL_AUTH_TOKEN=xxxxx--xxxxx
# CORS_ORIGIN=http://localhost:3000,http://localhost:3010  # Comma-separated. Empty = allow all

# ExchangeRate-API (free, no key required)
EXCHANGERATE_API_URL=https://open.er-api.com/v6
# EXCHANGERATE_API_KEY=xxxxx--xxxxx

# Frankfurter (free, no key, ECB data)
FRANKFURTER_API_URL=https://api.frankfurter.app

# exchangerate.host (free tier, optional key)
EXCHANGERATE_HOST_URL=https://api.exchangerate.host
# EXCHANGERATE_HOST_KEY=  # optional, for premium tier

# API Daily Limits (free tier defaults)
EXCHANGERATE_API_DAILY_LIMIT=50
FRANKFURTER_DAILY_LIMIT=500
EXCHANGERATE_HOST_DAILY_LIMIT=100

# Smart Cron Intervals (ms) — controls automatic fiat rate fetch frequency
# Default: 1h min, 2h max → ~12-24 auto-fetches/day (safe for free tiers)
CRON_MIN_INTERVAL_MS=3600000
CRON_MAX_INTERVAL_MS=7200000

# Asset Registry Service
ASSET_REGISTRY_URL=http://localhost:3010/api/v1/internal

# Additional variables referenced in this project; replace markers only in local configuration.
CORS_ORIGIN=http://localhost:3000
EXCHANGERATE_HOST_API_KEY=xxxxx--xxxxx
FAWAZ_CURRENCY_DAILY_LIMIT=xxxxx--xxxxx
FAWAZ_CURRENCY_URL=xxxxx--xxxxx
FLOATRATES_DAILY_LIMIT=xxxxx--xxxxx
FLOATRATES_URL=xxxxx--xxxxx
