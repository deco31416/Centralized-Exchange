# Plantilla segura de entorno: este archivo no contiene credenciales válidas.
# Copia a .env local o usa un gestor de secretos; nunca pongas claves reales en Git.

# Server
PORT=3012
NODE_ENV=development

# App Identity
APP_NAME=DECO Exchange
SWAGGER_DESCRIPTION=Microservicio de precios crypto con agregación multi-source, motor de entropía, bandas de precio (admin/auto), deltas por red, y sistema de alertas tipo semáforo.
CONTACT_URL=https://exchange.example.invalid
CONTACT_EMAIL=xxxxx--xxxxx@example.invalid
LICENSE_NAME=MIT
LICENSE_URL=https://opensource.org/licenses/MIT

# Database
MONGODB_URI=mongodb://localhost:27017/deco-exchange-micro
REDIS_URI=redis://localhost:6379

# Security
INTERNAL_AUTH_TOKEN=xxxxx--xxxxx
# CORS_ORIGIN=http://localhost:3000,http://localhost:3010  # Comma-separated. Empty = allow all

# CryptoCompare
CRYPTO_API_URL=https://min-api.cryptocompare.com
CRYPTO_API_SECRET=xxxxx--xxxxx

# CoinGecko
COINGECKO_API_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=xxxxx--xxxxx

# CoinMarketCap
COINMARKETCAP_API_URL=https://pro-api.coinmarketcap.com
COINMARKETCAP_API_KEY=xxxxx--xxxxx

# API Daily Limits (free tier defaults)
COINGECKO_DAILY_LIMIT=300
COINMARKETCAP_DAILY_LIMIT=300
CRYPTOCOMPARE_DAILY_LIMIT=3000

# Smart Cron Intervals (ms) — controls automatic API fetch frequency
# Default: 1h min, 4h max → ~24 auto-fetches/day (safe for free tiers)
CRON_MIN_INTERVAL_MS=3600000
CRON_MAX_INTERVAL_MS=14400000

# Asset Registry Service
ASSET_REGISTRY_URL=http://localhost:3010/api/v1/internal

# Additional variables referenced in this project; replace markers only in local configuration.
CORS_ORIGIN=http://localhost:3000
