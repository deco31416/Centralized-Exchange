# Plantilla segura de entorno: este archivo no contiene credenciales válidas.
# Copia a .env local o usa un gestor de secretos; nunca pongas claves reales en Git.

NODE_ENV=development
PORT=3000
API_PREFIX=api
MONGODB_URI=mongodb://localhost:27017/deco-p2p-local
CORS_ORIGINS=http://localhost:3000
INTERNAL_AUTH_TOKEN=xxxxx--xxxxx
P2P_FIELD_ENCRYPTION_KEY=xxxxx--xxxxx
P2P_ENABLE_INTERNAL_FIAT_WALLET=false
AUTH_SERVICE_URL=xxxxx--xxxxx
NOTIFICATIONS_SERVICE_URL=xxxxx--xxxxx
WALLET_LEDGER_SERVICE_URL=xxxxx--xxxxx
PRICING_FEE_AGGREGATOR_URL=xxxxx--xxxxx
CUSTODY_CRYPTO_SERVICE_URL=xxxxx--xxxxx
SIGNATURE_KEYS_SERVICE_URL=xxxxx--xxxxx
