# Plantilla segura de entorno: este archivo no contiene credenciales válidas.
# Copia a .env local o usa un gestor de secretos; nunca pongas claves reales en Git.

# ============================================================
# DECO31416 Admin Notifications Microservice
# Copiar a .env.local y completar con valores reales.
# No commitear .env.local.
# ============================================================

# Server
PORT=7002
NODE_ENV=development
HTTPS_REDIRECT_ENABLED=false
ENABLE_SWAGGER=true

# CORS: en produccion usar allowlist explicita.
# Produccion:
# CORS_ORIGIN=https://tu-dominio.example,https://apid3c0.deco31416.com
CORS_ORIGIN=http://localhost:3100,http://localhost:4000,http://localhost:7001

# Redis para BullMQ
REDIS_URI=redis://localhost:6379

# Resend
RESEND_API_KEY=xxxxx--xxxxx
RESEND_FROM_EMAIL=soporte@deco31416.com

# Twilio opcional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=xxxxx--xxxxx
TWILIO_FROM_NUMBER=

# Service-to-service authentication
# Debe coincidir con NOTIFICATIONS_SERVICE_TOKEN en exchange--micro-auth.
SERVICE_TOKENS=xxxxx--xxxxx

# HMAC opcional para integraciones S2S futuras
HMAC_KEYS=xxxxx--xxxxx

# Internal Auth Token compartido si se habilitan endpoints internos extra
INTERNAL_AUTH_TOKEN=xxxxx--xxxxx

# Rate limiting
EMAIL_RATE_MAX=60
SMS_RATE_MAX=120

# Queues
QUEUE_EMAIL_CONCURRENCY=10
QUEUE_SMS_CONCURRENCY=25
QUEUE_MAX_ATTEMPTS=6

# Templates
BASE_TEMPLATE_URL=https://www.deco31416.com

# Sentry Observability (opcional)
# Proyecto sugerido: deco-notifications
# Dejar SENTRY_DSN vacio para desactivar. No enviar PII ni secretos.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_ENABLE_LOGS=false
