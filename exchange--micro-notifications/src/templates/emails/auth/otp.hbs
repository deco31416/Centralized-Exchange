<!-- subject: Account Verification Code -->
<!--
  DECO31416 — Transactional Email Template (Account Verification / 2FA)

  Pro version: table-based layout + mostly inline styles for maximum compatibility
  across Gmail and Outlook.

  Variables (Handlebars):
  - displayName (optional)
  - code (required)
  - expirationMinutes (required)
-->

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <title>Account Verification Code</title>

    <style>
      /* Minimal resets (most styling is inline) */
      html, body { margin: 0 !important; padding: 0 !important; height: 100% !important; width: 100% !important; }
      table, td { border-collapse: collapse !important; mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
      img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; }
      a { text-decoration: none; }
      a[x-apple-data-detectors] { color: inherit !important; text-decoration: none !important; }
    </style>
  </head>

  <body style="margin:0; padding:0; background:#f3f4f6;">
    <!-- Preheader (hidden in most clients) -->
    <div style="display:none; font-size:1px; line-height:1px; max-height:0; max-width:0; opacity:0; overflow:hidden; mso-hide:all;">
      Your DECO31416 verification code is {{code}}. Expires in {{expirationMinutes}} minutes.
    </div>

    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f3f4f6;">
      <tr>
        <td align="center" style="padding:28px 12px;">
          <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:600px; max-width:600px;">
            <tr>
              <td style="background:#ffffff; border:1px solid #e5e7eb; border-radius:16px; overflow:hidden;">
                <!-- Header -->
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                  <tr>
                    <td style="padding:22px 26px; border-bottom:1px solid #e5e7eb;">
                      <!-- Brand -->
                      <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:14px; letter-spacing:0.12em; color:#111827; font-weight:800;">
                        DECO31416
                      </div>
                      <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:12px; color:#6b7280; margin-top:6px;">
                        Account Security • Verification
                      </div>
                    </td>
                  </tr>
                </table>

                <!-- Body -->
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                  <tr>
                    <td style="padding:26px;">
                      <!-- Title -->
                      <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:22px; line-height:28px; color:#111827; font-weight:800; margin:0 0 12px 0;">
                        Account Verification Code
                      </div>

                      <!-- Greeting -->
                      <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:15px; line-height:22px; color:#111827; margin:0 0 14px 0;">
                        {{#if displayName}}Hi {{displayName}},{{else}}Hi,{{/if}}
                      </div>

                      <!-- Message -->
                      <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:14px; line-height:22px; color:#374151; margin:0 0 18px 0;">
                        We received a request to verify your DECO31416 account. Use the code below to complete verification.
                      </div>

                      <!-- Code block -->
                      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0 0 18px 0;">
                        <tr>
                          <td align="center" style="padding:14px 12px;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="background:#f9fafb; border:1px solid #d1d5db; border-radius:12px;">
                              <tr>
                                <td align="center" style="padding:18px 22px;">
                                  <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:12px; letter-spacing:0.14em; color:#6b7280; margin:0 0 8px 0;">
                                    VERIFICATION CODE
                                  </div>
                                  <div style="font-family:Consolas, Menlo, Monaco, 'Courier New', monospace; font-size:34px; line-height:40px; letter-spacing:0.18em; color:#111827; font-weight:800;">
                                    {{code}}
                                  </div>
                                  <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:12px; color:#6b7280; margin-top:10px;">
                                    Expires in <strong style="color:#111827; font-weight:700;">{{expirationMinutes}} minutes</strong>
                                  </div>
                                </td>
                              </tr>
                            </table>
                          </td>
                        </tr>
                      </table>

                      <!-- Security -->
                      <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:13px; line-height:20px; color:#111827; font-weight:800; margin:0 0 8px 0;">
                        Security notice
                      </div>
                      <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:13px; line-height:20px; color:#374151; margin:0 0 10px 0;">
                        Do not share this code with anyone. DECO31416 will never ask for your verification code by phone, chat, or email.
                      </div>
                      <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:13px; line-height:20px; color:#374151; margin:0;">
                        If you didn’t request this code, ignore this email and contact support at
                        <a href="mailto:soporte@deco31416.com" style="color:#111827; text-decoration:underline;">soporte@deco31416.com</a>.
                      </div>

                      <!-- Divider -->
                      <div style="height:1px; background:#e5e7eb; margin:22px 0;"></div>

                      <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:12px; line-height:18px; color:#6b7280;">
                        This is an automated security message from DECO31416.
                      </div>
                    </td>
                  </tr>
                </table>

                <!-- Footer -->
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                  <tr>
                    <td align="center" style="padding:18px 18px; background:#ffffff; border-top:1px solid #e5e7eb;">
                      <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:12px; letter-spacing:0.10em; color:#111827; font-weight:700;">
                        Secure • Fast • Reliable
                      </div>
                      <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:11px; color:#6b7280; margin-top:8px;">
                        © {{currentYear}} DECO31416. All rights reserved.
                      </div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style="height:18px; line-height:18px; font-size:0;">&nbsp;</td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>