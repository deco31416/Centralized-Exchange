<!-- subject: DECO31416 — Welcome -->

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <title>DECO31416 — Welcome</title>

    <style>
      html, body { margin: 0 !important; padding: 0 !important; height: 100% !important; width: 100% !important; }
      table, td { border-collapse: collapse !important; mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
      img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; }
      a { text-decoration: none; }
      a[x-apple-data-detectors] { color: inherit !important; text-decoration: none !important; }
    </style>
  </head>

  <body style="margin:0; padding:0; background:#f3f4f6;">
    <div style="display:none; font-size:1px; line-height:1px; max-height:0; max-width:0; opacity:0; overflow:hidden; mso-hide:all;">
      Welcome to DECO31416. Open your dashboard: {{dashboardUrl}}
    </div>

    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f3f4f6;">
      <tr>
        <td align="center" style="padding:28px 12px;">
          <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:600px; max-width:600px;">
            <tr>
              <td style="background:#ffffff; border:1px solid #e5e7eb; border-radius:16px; overflow:hidden;">
                <!-- Header -->
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                  <tr>
                    <td style="padding:22px 26px; border-bottom:1px solid #e5e7eb;">
                      <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:14px; letter-spacing:0.12em; color:#111827; font-weight:800;">
                        DECO31416
                      </div>
                      <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:12px; color:#6b7280; margin-top:6px;">
                        Welcome • Getting Started
                      </div>
                    </td>
                  </tr>
                </table>

                <!-- Body -->
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                  <tr>
                    <td style="padding:26px;">
                      <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:22px; line-height:28px; color:#111827; font-weight:800; margin:0 0 12px 0;">
                        Welcome aboard
                      </div>

                      <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:15px; line-height:22px; color:#111827; margin:0 0 14px 0;">
                        {{#if displayName}}Hi {{displayName}},{{else}}Hi,{{/if}}
                      </div>

                      <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:14px; line-height:22px; color:#374151; margin:0 0 14px 0;">
                        Your DECO31416 account is ready. Here are a few things you can do next:
                      </div>

                      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0 0 18px 0;">
                        <tr>
                          <td style="padding:10px 12px; border:1px solid #e5e7eb; border-radius:12px; background:#f9fafb;">
                            <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:13px; line-height:20px; color:#111827; font-weight:700;">Complete your profile</div>
                            <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:12px; line-height:18px; color:#6b7280;">Add your details to get started faster.</div>
                          </td>
                        </tr>
                        <tr><td style="height:10px; line-height:10px; font-size:0;">&nbsp;</td></tr>
                        <tr>
                          <td style="padding:10px 12px; border:1px solid #e5e7eb; border-radius:12px; background:#f9fafb;">
                            <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:13px; line-height:20px; color:#111827; font-weight:700;">Enable security features</div>
                            <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:12px; line-height:18px; color:#6b7280;">Turn on strong protections like 2FA.</div>
                          </td>
                        </tr>
                        <tr><td style="height:10px; line-height:10px; font-size:0;">&nbsp;</td></tr>
                        <tr>
                          <td style="padding:10px 12px; border:1px solid #e5e7eb; border-radius:12px; background:#f9fafb;">
                            <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:13px; line-height:20px; color:#111827; font-weight:700;">Explore your dashboard</div>
                            <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:12px; line-height:18px; color:#6b7280;">View your account and manage your settings.</div>
                          </td>
                        </tr>
                      </table>

                      <div style="text-align:center; margin:0 0 12px 0;">
                        <a href="{{dashboardUrl}}" style="display:inline-block; background:#111827; color:#ffffff; padding:12px 18px; border-radius:10px; font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:13px; font-weight:800; letter-spacing:0.02em;">
                          Go to dashboard
                        </a>
                      </div>

                      <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:12px; line-height:18px; color:#6b7280; margin:0 0 6px 0;">
                        If the button doesn't work, copy and paste this link into your browser:
                      </div>
                      <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:12px; line-height:18px; color:#111827; word-break:break-all;">
                        {{dashboardUrl}}
                      </div>

                      <div style="height:1px; background:#e5e7eb; margin:22px 0;"></div>

                      <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:12px; line-height:18px; color:#6b7280;">
                        This is an automated message from DECO31416.
                      </div>
                    </td>
                  </tr>
                </table>

                <!-- Footer -->
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                  <tr>
                    <td align="center" style="padding:18px 18px; background:#ffffff; border-top:1px solid #e5e7eb;">
                      <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:12px; letter-spacing:0.10em; color:#111827; font-weight:700;">
                        Secure • Fast • Reliable
                      </div>
                      <div style="font-family:Segoe UI, Roboto, Helvetica, Arial, sans-serif; font-size:11px; color:#6b7280; margin-top:8px;">
                        © {{currentYear}} DECO31416. All rights reserved.
                      </div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style="height:18px; line-height:18px; font-size:0;">&nbsp;</td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
