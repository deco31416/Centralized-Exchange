# Plantilla segura de entorno: este archivo no contiene credenciales válidas.
# Copia a .env local o usa un gestor de secretos; nunca pongas claves reales en Git.

PORT=9042
NODE_ENV=development

# Internal service auth shared across gateways and microservices.
INTERNAL_AUTH_TOKEN=xxxxx--xxxxx

# Unified development database.
MONGODB_URI=mongodb+srv://xxxxx--xxxxx:xxxxx--xxxxx@<cluster>/deco-exchange-admin

# Seed initial demo data when collections are empty.
POINTS_DECO_SEED_DEFAULTS=true

# Limits policy precheck before creating operational orders.
LIMITS_POLICY_SERVICE_URL=http://localhost:9031/api/v1
LIMITS_POLICY_TIMEOUT_MS=3000
POINTS_DECO_LIMITS_FAIL_MODE=review

# Fiat pricing for Puntos Deco quotes. If unavailable, the micro falls back to
# conservative local demo rates and marks the quote as local-fallback.
PRICING_FIAT_SERVICE_URL=http://localhost:9023/api/v1
POINTS_DECO_PRICING_TIMEOUT_MS=3000
POINTS_DECO_PRICING_CORRIDOR=retail

# Wallet ledger holds for cash-out/remittance operations.
WALLET_LEDGER_SERVICE_URL=http://localhost:9001/api/v1
POINTS_DECO_LEDGER_FAIL_MODE=review

# Additional variables referenced in this project; replace markers only in local configuration.
AUDIT_FIAT_FLOWS_SERVICE_URL=xxxxx--xxxxx
CUSTODY_FIAT_SERVICE_URL=xxxxx--xxxxx
POINTS_DECO_CUSTODY_FIAT_FAIL_MODE=xxxxx--xxxxx
