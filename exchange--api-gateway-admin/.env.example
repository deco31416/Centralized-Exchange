# Plantilla segura de entorno: este archivo no contiene credenciales válidas.
# Copia a .env local o usa un gestor de secretos; nunca pongas claves reales en Git.

# PORT
PORT=8080

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=200

# Internal Service Authentication
INTERNAL_AUTH_TOKEN=xxxxx--xxxxx

# Notifications Service Auth (service-to-service)
# Must match a value inside micro-notifications-admin SERVICE_TOKENS
NOTIFICATIONS_SERVICE_TOKEN=xxxxx--xxxxx

# Backend Services
AUTH_SERVICE_URL=http://localhost:7002
NOTIFICATIONS_SERVICE_URL=http://localhost:7003

# JWT Configuration (must match microservices)
JWT_SECRET=xxxxx--xxxxx
JWT_EXPIRATION=1h

# Environment
NODE_ENV=development

# API Configuration
API_PREFIX=api/v1
API_TIMEOUT=30000

# Additional variables referenced in this project; replace markers only in local configuration.
CORS_ORIGIN=http://localhost:3000
DECOPAY_SERVICE_URL=xxxxx--xxxxx
FUNDING_SERVICE_URL=xxxxx--xxxxx
INTERNAL_TRANSFERS_SERVICE_URL=xxxxx--xxxxx
LOANS_SERVICE_URL=xxxxx--xxxxx
MOVEMENTS_SERVICE_URL=xxxxx--xxxxx
P2P_CORE_SERVICE_URL=xxxxx--xxxxx
PAYMENTS_SERVICE_URL=xxxxx--xxxxx
PRICING_AGGREGATOR_SERVICE_URL=xxxxx--xxxxx
REDEEM_SERVICE_URL=xxxxx--xxxxx
REMITTANCES_SERVICE_URL=xxxxx--xxxxx
SAVINGS_SERVICE_URL=xxxxx--xxxxx
SEND_SERVICE_URL=xxxxx--xxxxx
SIGNATURE_SERVICE_URL=xxxxx--xxxxx
WALLET_LEDGER_SERVICE_URL=xxxxx--xxxxx
