# Plantilla segura de entorno: este archivo no contiene credenciales válidas.
# Copia a .env local o usa un gestor de secretos; nunca pongas claves reales en Git.

NODE_ENV=development
APP_NAME=deco-remittances-local
APP_VERSION=0.0.0-local
PORT=3000
API_PREFIX=api
MONGODB_URI=mongodb://localhost:27017/deco-remittances-local
