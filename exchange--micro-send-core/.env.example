# Plantilla segura de entorno: este archivo no contiene credenciales válidas.
# Copia a .env local o usa un gestor de secretos; nunca pongas claves reales en Git.

PORT=3010

AUTH_SERVICE_URL=http://localhost:7000/api/v1
NOTIFICATIONS_SERVICE_URL=http://localhost:7004/api/v1
WALLET_LEDGER_SERVICE_URL=http://localhost:9001/api/v1
PAYMENTS_SERVICE_URL=http://localhost:9000/api/v1
INTERNAL_TRANSFERS_SERVICE_URL=http://localhost:3006/api/v1

INTERNAL_AUTH_TOKEN=xxxxx--xxxxx

# Optional endpoint overrides
Deco31416_EXECUTE_PATH=/internal/transfers/p2p
WALLET_EXECUTE_PATH=/internal/wallet/transfers
BANK_TRANSFER_PATH=/bank-transfers
SPEI_PAYMENT_ORDERS_PATH=/spei/stp/payment-orders

# Optional quote configuration
SEND_Deco31416_FEE_RATE=0.01
SEND_WALLET_FEE_RATE=0.005
SEND_BANK_FEE_RATE=0.015
SEND_SPEI_FEE_RATE=0.012
MONEY_MINOR_UNITS_FACTOR=100

# Optional SPEI sender defaults
SPEI_ORDENANTE_NAME=Deco31416 Exchange
SPEI_ORDENANTE_ACCOUNT=000000000000000000
SPEI_ORDENANTE_BANK=90646

# Optional execution notification
SEND_EXECUTION_EMAIL_TEMPLATE=
SEND_EXECUTION_FALLBACK_EMAIL=

# Additional variables referenced in this project; replace markers only in local configuration.
MONGODB_URI=mongodb://localhost:27017/deco-local
NODE_ENV=development
