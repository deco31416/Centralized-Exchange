# Plantilla segura de entorno: este archivo no contiene credenciales válidas.
# Copia a .env local o usa un gestor de secretos; nunca pongas claves reales en Git.

# ── Exchange--micro-movements-core ── Puerto 9012 ──
NODE_ENV=development
PORT=9012

# ── Swagger (solo development, false en producción) ──
ENABLE_SWAGGER=false

# ── Auth interno entre microservicios ──
INTERNAL_AUTH_TOKEN=xxxxx--xxxxx

# ── Integrations ──
WALLET_LEDGER_SERVICE_URL=http://localhost:9001/api/v1
REMITTANCES_SERVICE_URL=http://localhost:9015/api/v1
SAVINGS_SERVICE_URL=http://localhost:9014/api/v1

# Additional variables referenced in this project; replace markers only in local configuration.
WALLET_LEDGER_URL=xxxxx--xxxxx
