# Plantilla segura de entorno: este archivo no contiene credenciales válidas.
# Copia a .env local o usa un gestor de secretos; nunca pongas claves reales en Git.

# ============================================================
# DECO31416 Admin Auth Microservice
# Copiar a .env.local y completar con valores reales.
# No commitear .env.local.
# ============================================================

# Server
PORT=7001
NODE_ENV=development
ENABLE_SWAGGER=true

# CORS: solo admin panel y backend gateway.
# Produccion:
# CORS_ORIGIN=https://tu-dominio.example,https://apid3c0.deco31416.com
CORS_ORIGIN=http://localhost:3100,http://localhost:4000
HTTPS_REDIRECT_ENABLED=false

# MongoDB
# Puede compartir el cluster Mongo de DECO31416 usando una base separada.
# Ejemplo Atlas:
# MONGODB_URI=mongodb+srv://xxxxx--xxxxx:xxxxx--xxxxx@<cluster>/deco31416-admin-auth
MONGODB_URI=mongodb://localhost:27017/deco31416-admin-auth

# Redis
# Usar el mismo proveedor Redis de DECO31416 o uno dedicado para auth.
REDIS_URI=redis://localhost:6379

# JWT / sesiones administrativas
JWT_SECRET=xxxxx--xxxxx
JWT_ISSUER=deco31416-admin-auth
JWT_ACCESS_TOKEN_TTL=600
JWT_REFRESH_TOKEN_TTL=28800

# Password hashing
ARGON2_PEPPER=xxxxx--xxxxx
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# OTP login admin
LOGIN_OTP_ENABLED=true
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN=60
OTP_DEBUG_RETURN_CODE=false

# Provisioning controlado
# Mantener false/vacio salvo cuando se cree un operador de forma controlada.
ADMIN_AUTH_ALLOW_REGISTRATION=false

# Reset password / reauth
RESET_TOKEN_TTL_SECONDS=600
SENSITIVE_REAUTH_TTL_SECONDS=600

# SMS OTP opcional
SMS_OTP_LENGTH=6
SMS_OTP_TTL_SECONDS=300
SMS_OTP_MAX_ATTEMPTS=3
SMS_OTP_RESEND_COOLDOWN=60
SMS_OTP_VERIFIED_TTL_SECONDS=600

# TOTP
TOTP_ISSUER=DECO31416
TOTP_SETUP_TTL_SECONDS=600
MFA_TOTP_ENC_KEY=replace_with_32_plus_random_chars

# Seguridad comercial
WITHDRAWALS_HOLD_MINUTES_DEFAULT=60
MAX_CONCURRENT_SESSIONS=5
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=80

# Politica de email
BLOCKED_DOMAINS=yopmail.com,temp-mail.org,guerrillamail.com,mailinator.com
EMAIL_DOMAIN_POLICY_ENABLED=true

# URLs DECO31416
FRONTEND_URL=http://localhost:3100
DASHBOARD_URL=http://localhost:3100

# Microservicio de notificaciones administrativas
NOTIFICATIONS_SERVICE_URL=http://localhost:7002
NOTIFICATIONS_BASE_URL=http://localhost:7002
NOTIFICATIONS_SERVICE_TOKEN=xxxxx--xxxxx

# Internal service-to-service auth for /internal/*
INTERNAL_AUTH_TOKEN=xxxxx--xxxxx

# Optional legacy SMTP/SMS providers. Prefer notifications microservice.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=xxxxx--xxxxx
SMS_API_KEY=xxxxx--xxxxx
SMS_API_SECRET=xxxxx--xxxxx

# Sentry Observability (opcional)
# Proyecto sugerido: deco-admin-auth
# Dejar SENTRY_DSN vacio para desactivar. No enviar PII ni secretos.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_ENABLE_LOGS=false

# Additional variables referenced in this project; replace markers only in local configuration.
MFA_ENC_KEY=xxxxx--xxxxx
MONGO_URL=mongodb://localhost:27017/deco-local
REDIS_URL=redis://localhost:6379
