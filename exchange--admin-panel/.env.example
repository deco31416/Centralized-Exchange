# Plantilla segura de entorno: este archivo no contiene credenciales válidas.
# Copia a .env local o usa un gestor de secretos; nunca pongas claves reales en Git.

# Admin panel (local example only)
NODE_ENV=development
ADMIN_GATEWAY_URL=xxxxx--xxxxx
ADMIN_GATEWAY_API_PREFIX=/api
INTERNAL_AUTH_TOKEN=xxxxx--xxxxx
NEXT_PUBLIC_ADMIN_PATH=/admin
NEXT_PUBLIC_AUTH_API_BASE=xxxxx--xxxxx
NEXT_PUBLIC_REQUIRE_OTP=true
NEXT_PUBLIC_ALLOWED_IPS=xxxxx--xxxxx
DISABLE_AUTH=false
SKIP_AUTH=false
SKIP_AUTH_IN_DEV=false
REDIS_URI=redis://localhost:6379
REDIS_URL=redis://localhost:6379
