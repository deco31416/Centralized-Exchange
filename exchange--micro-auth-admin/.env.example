# Plantilla segura de entorno: este archivo no contiene credenciales válidas.
# Copia a .env local o usa un gestor de secretos; nunca pongas claves reales en Git.

# Server Configuration
PORT=7002
API_DOCS_URL=http://localhost:7002/api/docs
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/micro-ng-auth-admin

# Redis Configuration (Railway-compatible)
# REQUIRED: Must be set. No fallback to localhost.
# Railway will automatically populate this via service connection.
# Format: redis://default:password@host:port
REDIS_URL=redis://<railway-redis-url>

# JWT Configuration
# SECURITY WARNING: Change these values in production!
JWT_SECRET=xxxxx--xxxxx
JWT_ISSUER=micro-ng-auth-admin
JWT_ACCESS_TOKEN_TTL=600
JWT_REFRESH_TOKEN_TTL=3888000

# Argon2 Password Hashing Configuration
# SECURITY WARNING: Change the pepper value in production!
ARGON2_PEPPER=xxxxx--xxxxx
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# OTP Configuration
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN=60
# Adaptive OTP Policy: if true, always require OTP for login (ignores adaptive logic)
LOGIN_OTP_ENABLED=false

# Reset password session (v2)
# Tiempo para completar el reset tras verificar el OTP del email
RESET_TOKEN_TTL_SECONDS=600

# Ventana de reauth para cambios sensibles (email OTP verificado recientemente)
# Si está dentro del TTL, no se vuelve a pedir el email OTP para cambiar datos sensibles.
SENSITIVE_REAUTH_TTL_SECONDS=600

# Additional factor: SMS OTP (opcional)
SMS_OTP_LENGTH=6
SMS_OTP_TTL_SECONDS=300
SMS_OTP_MAX_ATTEMPTS=3
SMS_OTP_RESEND_COOLDOWN=60
SMS_OTP_VERIFIED_TTL_SECONDS=600

# Third factor: Google Authenticator (TOTP)
TOTP_ISSUER=Deco31416Exchange
TOTP_SETUP_TTL_SECONDS=600
# SECURITY: set a strong secret in production
MFA_TOTP_ENC_KEY=change-me-in-production-min-32-chars

# Withdrawals Hold Policy (minutes)
# Default: 60 (1 hour)
WITHDRAWALS_HOLD_MINUTES_DEFAULT=60

# DEV ONLY: if true (and NODE_ENV!=production), the v2 endpoints may include `debugOtpCode`
OTP_DEBUG_RETURN_CODE=false

# Frontend URL (para links de verificación / reset)
FRONTEND_URL=http://localhost:3001

# Path de reset-password en el admin panel (ruta ofuscada)
# Ej: /loginDeco31416/reset-password
FRONTEND_RESET_PASSWORD_PATH=/loginDeco31416/reset-password

# Local seed (dev-only): create/update an initial user without hardcoding secrets
# Usage: set these values locally (do NOT commit real credentials)
# SEED_USER_EMAIL=your-user@example.com
# SEED_USER_PASSWORD=xxxxx--xxxxx
# SEED_USER_DISPLAY_NAME=Dev User
# SEED_USER_ORG_ID=

# Email Domain Policy
BLOCKED_DOMAINS=yopmail.com,temp-mail.org,guerrillamail.com,mailinator.com
EMAIL_DOMAIN_POLICY_ENABLED=true

# Notifications Service URL
NOTIFICATIONS_SERVICE_URL=http://localhost:7003
NOTIFICATIONS_SERVICE_TOKEN=xxxxx--xxxxx

# Internal service-to-service auth token (used by /internal/* endpoints)
INTERNAL_AUTH_TOKEN=xxxxx--xxxxx

# Email Configuration (Optional - for email verification and password reset)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=xxxxx--xxxxx

# SMS Configuration (Optional - for SMS-based MFA)
SMS_API_KEY=xxxxx--xxxxx
SMS_API_SECRET=xxxxx--xxxxx

# Rate Limiting Configuration
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
MAX_CONCURRENT_SESSIONS=10

# Example Production Values (commented out):
# NODE_ENV=production
# PORT=7001
# CORS_ORIGIN=https://yourdomain.com
# MONGODB_URI=mongodb://xxxxx--xxxxx:xxxxx--xxxxx@your-mongo-cluster/micro-ng-auth?ssl=true
# REDIS_URI=redis://username:password@your-redis-host:6379
# JWT_SECRET=xxxxx--xxxxx
# ARGON2_PEPPER=xxxxx--xxxxx

# Additional variables referenced in this project; replace markers only in local configuration.
ATTEMPT_WINDOW_MINUTES=xxxxx--xxxxx
HTTPS_REDIRECT_ENABLED=false
LOCKOUT_DURATION_MINUTES=xxxxx--xxxxx
MAX_LOGIN_ATTEMPTS=xxxxx--xxxxx
MFA_ENC_KEY=xxxxx--xxxxx
NOTIFICATIONS_BASE_URL=xxxxx--xxxxx
REDIS_URI=redis://localhost:6379
