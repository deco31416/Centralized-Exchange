# Admin Notifications Microservice (local)
# Copy this file to .env.local (do NOT commit .env.local)

PORT=7003
NODE_ENV=development

# Use Railway Redis here (shared with other services)
# Example: redis://default:password@host:port
REDIS_URI=redis://default:password@host:port

# Providers (set real values in Railway)
RESEND_API_KEY=xxxxx--xxxxx
RESEND_FROM_EMAIL=noreply@example.com

TWILIO_ACCOUNT_SID=change-me
TWILIO_AUTH_TOKEN=xxxxx--xxxxx
TWILIO_FROM_NUMBER=+10000000000

# Service-to-service auth (Bearer)
# The gateway will call with: Authorization: Bearer <NOTIFICATIONS_SERVICE_TOKEN>
SERVICE_TOKENS=xxxxx--xxxxx

# Optional HMAC auth
# HMAC_KEYS=xxxxx--xxxxx

# Internal token shared across admin services
INTERNAL_AUTH_TOKEN=xxxxx--xxxxx

HTTPS_REDIRECT_ENABLED=false

EMAIL_RATE_MAX=60
SMS_RATE_MAX=120
QUEUE_EMAIL_CONCURRENCY=10
QUEUE_SMS_CONCURRENCY=25
QUEUE_MAX_ATTEMPTS=6
