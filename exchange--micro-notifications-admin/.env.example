# Plantilla segura de entorno: este archivo no contiene credenciales válidas.
# Copia a .env local o usa un gestor de secretos; nunca pongas claves reales en Git.

# Server Configuration
PORT=7003
NODE_ENV=development

# Redis Configuration (Required)
REDIS_URI=redis://localhost:6379

# Resend Configuration (Required)
RESEND_API_KEY=xxxxx--xxxxx
RESEND_FROM_EMAIL=xxxxx--xxxxx@example.invalid

# Twilio Configuration (Required)
TWILIO_ACCOUNT_SID=xxxxx--xxxxx
TWILIO_AUTH_TOKEN=xxxxx--xxxxx
TWILIO_FROM_NUMBER=+1234567890

# Service-to-Service Authentication (Required)
# JSON object mapping service names to bearer tokens
SERVICE_TOKENS=xxxxx--xxxxx

# Internal Auth Token (Shared between all microservices)
# SECURITY: Cambiar en producción - debe ser el mismo en todos los microservicios
# Generar nuevo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_AUTH_TOKEN=xxxxx--xxxxx

# HMAC Authentication (Optional)
# JSON object mapping service names to shared secrets for HMAC signatures
HMAC_KEYS=xxxxx--xxxxx

# Rate Limiting Configuration (Optional)
EMAIL_RATE_MAX=60
SMS_RATE_MAX=120

# Queue Configuration (Optional)
QUEUE_EMAIL_CONCURRENCY=10
QUEUE_SMS_CONCURRENCY=25
QUEUE_MAX_ATTEMPTS=6

# Template Configuration (Optional)
BASE_TEMPLATE_URL=https://yourdomain.com

# Additional variables referenced in this project; replace markers only in local configuration.
CORS_ORIGIN=http://localhost:3000
HTTPS_REDIRECT_ENABLED=false
