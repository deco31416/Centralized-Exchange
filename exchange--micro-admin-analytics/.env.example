# Plantilla segura de entorno: este archivo no contiene credenciales válidas.
# Copia a .env local o usa un gestor de secretos; nunca pongas claves reales en Git.

NODE_ENV=development
PORT=9029
SERVICE_NAME=exchange--micro-admin-analytics

# Gateway/internal auth
INTERNAL_AUTH_TOKEN=xxxxx--xxxxx

# Upstream services for internal aggregation.
AUTH_SERVICE_URL=http://localhost:7000
WALLET_LEDGER_SERVICE_URL=http://localhost:9001
P2P_CORE_SERVICE_URL=http://localhost:3021
KYC_RISK_SERVICE_URL=http://localhost:9028
PRICING_AGGREGATOR_SERVICE_URL=http://localhost:3013
