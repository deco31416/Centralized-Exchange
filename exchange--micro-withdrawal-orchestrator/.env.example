# Plantilla segura de entorno: este archivo no contiene credenciales válidas.
# Copia a .env local o usa un gestor de secretos; nunca pongas claves reales en Git.

# ── Exchange--micro-withdrawal-orchestrator ── Puerto 7015 ──
# Orquestador de retiros fiat y crypto — BlackCEX Exchange
# Copia este archivo a .env.local y completa los valores reales

NODE_ENV=development
PORT=7015

# ── Swagger (solo development, false en producción) ──
ENABLE_SWAGGER=false

# ── Data ──
MONGODB_URI=

# ── Auth interno entre microservicios ──
INTERNAL_AUTH_TOKEN=xxxxx--xxxxx

# ── Servicios consumidos ──
MICRO_AUTH_BASE_URL=http://localhost:7000
AUTH_BASE_URL=http://localhost:7000

# ── Política de retiros — 'closed' bloquea si no hay política definida ──
WITHDRAWALS_POLICY_FAIL_MODE=closed
