# Plantilla segura de entorno: este archivo no contiene credenciales válidas.
# Copia a .env local o usa un gestor de secretos; nunca pongas claves reales en Git.

# Service
NODE_ENV=development
PORT=9001
API_PREFIX=api/v1

# Data
MONGODB_URI=mongodb://localhost:27017/deco_micro_wallet_ledger_core
REDIS_URL=redis://localhost:6379

# Internal auth (service-to-service)
# SECURITY: Cambiar en producción - debe ser el mismo en todos los microservicios
# Generar nuevo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_AUTH_TOKEN=xxxxx--xxxxx

# External service URLs
NOTIFICATIONS_BASE_URL=http://localhost:7004/api/v1
NOTIFICATIONS_BEARER_TOKEN=xxxxx--xxxxx
PRICING_AGGREGATOR_URL=http://localhost:3013/api/v1

# Feature flags / circuit breakers
WITHDRAWALS_ENABLED=true
P2P_ENABLED=true

# OTP policy (v1 defaults)
OTP_REQUIRED_FOR_P2P=true
OTP_REQUIRED_FOR_WITHDRAWALS=true
OTP_REQUIRED_FOR_INTERNAL_PAYMENTS=true

# OTP bypass for dev/testing (6 digits)
OTP_BYPASS_CODE=xxxxx--xxxxx
OTP_TTL_SECONDS=300
OTP_RETURN_IN_RESPONSE=true

# Security
IP_WHITELIST_ENABLED=false
HTTPS_REDIRECT_ENABLED=false

# Additional variables referenced in this project; replace markers only in local configuration.
CORS_ORIGIN=http://localhost:3000
IP_WHITELIST=127.0.0.1
MONGODB_URL=mongodb://localhost:27017/deco-local
MONGO_URL=mongodb://localhost:27017/deco-local
REDIS_URI=redis://localhost:6379
