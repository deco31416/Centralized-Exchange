# Plantilla segura de entorno: este archivo no contiene credenciales válidas.
# Copia a .env local o usa un gestor de secretos; nunca pongas claves reales en Git.

# ─── Servidor ────────────────────
PORT=3020
API_PREFIX=api/v1
NODE_ENV=development

# ─── MongoDB ─────────────────────
MONGODB_URI=mongodb+srv://xxxxx--xxxxx:xxxxx--xxxxx@cluster.mongodb.net/deco-exchange-micro

# ─── Autenticación interna ───────
INTERNAL_AUTH_TOKEN=xxxxx--xxxxx

# ─── Microservicios ──────────────
SIGNATURE_KEYS_URL=http://localhost:3007/api/v1
WALLET_LEDGER_URL=http://localhost:9001/api/v1
INTERNAL_TRANSFERS_URL=http://localhost:3006/api/v1
AUTH_SERVICE_URL=http://localhost:7000/api/v1

# ─── Sesión ──────────────────────
SESSION_TTL_MINUTES=15
SESSION_MAX_AUTH_ATTEMPTS=5

# ─── CORS ────────────────────────
CORS_ORIGIN=http://localhost:3100
