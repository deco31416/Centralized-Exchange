# Plantilla segura de entorno: este archivo no contiene credenciales válidas.
# Copia a .env local o usa un gestor de secretos; nunca pongas claves reales en Git.

# ──────────────────────────────────────────
# Deco Exchange Frontend (Next.js)
# ──────────────────────────────────────────
# Copiar a .env.local para desarrollo local.
# NEXT_PUBLIC_* queda expuesto al navegador.
# ──────────────────────────────────────────

NODE_ENV=development

# App
NEXT_PUBLIC_APP_NAME="Deco Exchange"
NEXT_PUBLIC_APP_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gateway/BFF
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8081
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081
PRICING_AGGREGATOR_URL=http://localhost:3013/api/v1
ASSET_REGISTRY_URL=http://localhost:3010/api/v1

# Service-to-service token. Production fails closed if this is missing.
INTERNAL_AUTH_TOKEN=xxxxx--xxxxx

# DevTools guard
# true  = development: no bloquea consola.
# false = production: muestra advertencia anti fraude/self-XSS y redirige.
NEXT_PUBLIC_ENABLE_DEVTOOLS=true

# Legacy client API vars. Prefer the BFF routes under /api/*.
NEXT_PUBLIC_API_PROD=https://api.example.com
NEXT_PUBLIC_API_DEV=http://localhost:3000

# Additional variables referenced in this project; replace markers only in local configuration.
MARKET_BACKEND_TIMEOUT_MS=xxxxx--xxxxx
NEXT_PUBLIC_ENABLE_BLC_DEV_TOPUP=false
