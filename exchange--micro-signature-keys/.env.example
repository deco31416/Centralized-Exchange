# Plantilla segura de entorno: este archivo no contiene credenciales válidas.
# Copia a .env local o usa un gestor de secretos; nunca pongas claves reales en Git.

# Micro Signature Keys — Firma digital (PIN) y clave dinámica (TOTP-like)
# Copia este archivo a .env.local y ajusta los valores

# ── Server ──
PORT=3007
API_PREFIX=api/v1
NODE_ENV=development

# ── MongoDB ──
MONGODB_URI=mongodb://localhost:27017/Deco31416-signature-keys

# ── Seguridad interna (debe coincidir con api-gateway-user) ──
INTERNAL_AUTH_SECRET=xxxxx--xxxxx

# ── Servicio de notificaciones (OTP al cambiar firma) ──
NOTIFICATIONS_SERVICE_URL=http://localhost:7004
NOTIFICATIONS_INTERNAL_SECRET=xxxxx--xxxxx

# ── Configuración de firma (PIN) ──
SIGNATURE_PIN_LENGTH=6

# ── Configuración de clave dinámica (TOTP-like) ──
DYNAMIC_KEY_LENGTH=6
DYNAMIC_KEY_PERIOD_SECONDS=60
DYNAMIC_KEY_ALGORITHM=sha256

# Additional variables referenced in this project; replace markers only in local configuration.
INTERNAL_AUTH_TOKEN=xxxxx--xxxxx
