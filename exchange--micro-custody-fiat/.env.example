# Plantilla segura de entorno: este archivo no contiene credenciales válidas.
# Copia a .env local o usa un gestor de secretos; nunca pongas claves reales en Git.

# Service
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Data
MONGODB_URI=mongodb://localhost:27017/deco_micro_custody_fiat
REDIS_URL=redis://localhost:6379

# Webhooks ingest transport: 'bull' (requiere Redis) | 'inline' (dev local)
WEBHOOKS_INGEST_TRANSPORT=inline

# Internal auth (service-to-service)
# SECURITY: Cambiar en producción - debe ser el mismo en todos los microservicios
# Generar nuevo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_AUTH_TOKEN=xxxxx--xxxxx

# Microservices URLs
PAYMENTS_CORE_URL=http://localhost:3002/api/v1

# Outbox relay (reliable publishing hacia payments-core)
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_POLL_MS=5000
OUTBOX_RELAY_BATCH_SIZE=25
OUTBOX_RELAY_LOCK_MS=30000
OUTBOX_RELAY_MAX_ATTEMPTS=20
OUTBOX_RELAY_BACKOFF_BASE_MS=2000
OUTBOX_RELAY_BACKOFF_MAX_MS=600000

# Reconciliación (detección de eventos atascados)
OUTBOX_RECONCILE_ENABLED=true
OUTBOX_RECONCILE_POLL_MS=60000
OUTBOX_RECONCILE_STUCK_MS=900000
OUTBOX_RECONCILE_LIMIT=10

# Circuit breaker (payments-core)
CB_PAYMENTS_CORE_ENABLED=true
CB_PAYMENTS_CORE_FAILURE_THRESHOLD=5
CB_PAYMENTS_CORE_RESET_TIMEOUT_MS=30000

# Timeouts
PAYMENTS_CORE_TIMEOUT_MS=10000

# Provider secrets (webhook verification)
SPEI_STP_SECRET=xxxxx--xxxxx
SPEI_BANORTE_SECRET=xxxxx--xxxxx
MERCADOPAGO_WEBHOOK_SECRET=xxxxx--xxxxx
STRIPE_WEBHOOK_SECRET=xxxxx--xxxxx

# STP - Configuración completa (ver SPEI_STP_SIGNATURE.md)
SPEI_STP_EMPRESA=DECOEXCHANGE
SPEI_STP_PRIVATE_KEY_PATH=xxxxx--xxxxx
SPEI_STP_KEY_ALIAS=DECOEXCHANGE
SPEI_STP_KEY_PASSPHRASE=
SPEI_STP_API_URL_DEV=https://demo.stpmex.com:7024/spei/webservices
SPEI_STP_API_URL_PROD=https://example.invalid:7024/spei/webservices

# Provider selection (placeholder)
FIAT_DEFAULT_PROVIDER_SPEI=stp

# Additional variables referenced in this project; replace markers only in local configuration.
CUSTODY_FIAT_URL=xxxxx--xxxxx
LEDGER_CORE_URL=xxxxx--xxxxx
