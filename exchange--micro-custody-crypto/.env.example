# Plantilla segura de entorno: este archivo no contiene credenciales válidas.
# Copia a .env local o usa un gestor de secretos; nunca pongas claves reales en Git.

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/custody-ledger

# HD Wallet Configuration (BIP39/BIP44)
# Generate a 256-bit (64 hex characters) seed for deterministic address generation
# WARNING: Keep this secret secure! It controls all user deposit addresses
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HD_WALLET_SEED=xxxxx--xxxxx

# Blockchain RPC Endpoints
BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/
BSC_NETWORK=testnet
ETH_RPC_URL=xxxxx--xxxxx
ETH_NETWORK=testnet
BTC_NETWORK=testnet

# Hot Wallet Private Keys (for withdrawals)
# WARNING: Keep these extremely secure! Use KMS in production
BSC_HOT_WALLET_PRIVATE_KEY=xxxxx--xxxxx

# Redis (for Bull queues)
REDIS_HOST=localhost
REDIS_PORT=6379

# Internal auth (service-to-service)
# SECURITY: Cambiar en producción - debe ser el mismo en todos los microservicios
# Generar nuevo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_AUTH_TOKEN=xxxxx--xxxxx

# Additional variables referenced in this project; replace markers only in local configuration.
BTC_RPC_PASSWORD=xxxxx--xxxxx
BTC_RPC_URL=xxxxx--xxxxx
BTC_RPC_USER=xxxxx--xxxxx
ETH_HOT_WALLET_PRIVATE_KEY=xxxxx--xxxxx
NODE_ENV=development
PORT=3000
REDIS_PASSWORD=xxxxx--xxxxx
REDIS_USERNAME=xxxxx--xxxxx
STELLAR_NETWORK=testnet
TRON_NETWORK=testnet
